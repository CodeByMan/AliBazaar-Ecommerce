PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=ecommerce
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=alibazaar_session
AUTH_COOKIE_MAX_AGE_MS=86400000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# FYP default: mock. Change to stripe later without rewriting orders.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DELIVERY_CHARGE_PKR=250
FREE_DELIVERY_THRESHOLD_PKR=5000
CHECKOUT_RESERVATION_MINUTES=30
DELIVERY_ESTIMATE_DAYS=4

# Seeded single administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Contact form email delivery (authenticated customers only)
CONTACT_TO_EMAIL=info@alibazaar.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@alibazaar.com
