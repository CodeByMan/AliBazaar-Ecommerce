# ============================================================
# AliBazaar monorepo: NestJS + Next.js + Vite dashboard
# Place this file at the repository root.
# ============================================================

# Dependencies
**/node_modules/
.pnp/
.pnp.js

# Build outputs
**/dist/
**/.next/
**/out/
**/build/
**/.turbo/
**/.vercel/

# Test and coverage outputs
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
junit.xml

# TypeScript, ESLint, and framework caches
**/*.tsbuildinfo
**/.eslintcache
**/.cache/
**/.npm-cache/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime-generated uploads
# Keep only the two source-controlled default placeholders.
backend/uploads/*
!backend/uploads/defaults/
!backend/uploads/defaults/category-placeholder.svg
!backend/uploads/defaults/user-avatar.svg

# Temporary files
**/.temp/
**/.tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# Process and diagnostic files
*.pid
*.pid.lock
*.seed
report.*.json

# Local databases, dumps, and backups
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.sql.gz
backups/

# IDE and editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.launch
.settings/
.project
.classpath
.c9/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Local project archives
*.zip
*.rar
*.7z
