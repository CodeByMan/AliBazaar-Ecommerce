# ============================================================
# AliBazaar monorepo
# NestJS API + Next.js storefront + React/Vite admin dashboard
# ============================================================

# Dependencies
**/node_modules/
.pnp/
.pnp.js
.pnp.cjs

# Production builds and framework outputs
**/dist/
**/build/
**/.next/
**/out/
**/.turbo/
**/.vercel/
**/.netlify/

# Test outputs and reports
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/cypress/screenshots/
**/cypress/videos/
junit.xml

# TypeScript, ESLint, bundler, and tool caches
**/*.tsbuildinfo
**/.eslintcache
**/.cache/
**/.npm-cache/
**/.parcel-cache/
**/.vite/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Local runtime uploads
# Preserve only source-controlled fallback assets.
backend/uploads/*
!backend/uploads/defaults/
!backend/uploads/defaults/category-placeholder.svg
!backend/uploads/defaults/user-avatar.svg

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

